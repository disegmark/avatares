# Copia este archivo a .env.local y completa los valores reales.
# Todas las claves son server-only: nunca uses el prefijo NEXT_PUBLIC_.

# Clave compartida para entrar a la app. Sin ella la app queda bloqueada:
# cada generación consume créditos pagados de los proveedores.
STUDIO_ACCESS_KEY=

# Avatares hiperrealistas que hablan (stock o creados desde una foto).
HEYGEN_API_KEY=

# Voces: texto a voz y clonación instantánea. ELEVENLABS_MODEL_ID es
# opcional (por defecto eleven_multilingual_v2).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=

# Video por escenas (PixVerse, Kling, Veo) y unión final en un solo MP4.
FAL_KEY=

# Guion automático por escenas a partir de una idea (Claude).
ANTHROPIC_API_KEY=
